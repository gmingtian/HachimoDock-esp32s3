(label "GND" (at 251.46 160.02 0) (effects (font (size 1.016 1.016)) (justify right bottom)) (uuid 5fa4be97-deb6-5377-940e-fea333378583))
(text "HachimoDock S3 - A4 模块连接原理图" (at 20.32 15.24 0) (effects (font (face "Noto Sans CJK SC") (size 2.54 2.54)) (justify left top)) (uuid 6735ef80-993c-58a9-a356-3d3e0702fd72))
(text "与现有 PCB 对照；不是模块内部芯片原理图。相同网络标签表示电气相连。" (at 20.32 23.495 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 79cf4910-4800-5a16-a975-e40aab8b7fcb))
(text "01  果云开发板与底板排母" (at 20.32 40.64 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 19e2713f-1d1f-595b-8faa-47642295dc89))
(text "02  屏幕接口" (at 152.4 40.64 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 320a3686-6ed0-5253-b5d4-2fc22a04d5fb))
(text "03  功放模块" (at 251.46 40.64 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 3bf978fc-1249-5ed0-a79e-2b3e2bdbc20f))
(text "屏幕从 J1 接出：GND / VCC / SCL / SDA / RES / DC / CS / BLK" (at 150 114.3 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 418a63d7-ef77-521f-a00e-363e5ea0eb27))
(text "VIN = 3V3；SD = 3V3。" (at 251.46 107.95 0) (effects (font (face "Noto Sans CJK SC") (size 1.27 1.27)) (justify left top)) (uuid 83ee4d75-28f8-5ed5-a3c1-4a6ed89b0190))
(text "喇叭只接模块 SPK+ / SPK-；SPK- 不接 GND。" (at 251.46 113.03 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 2b0d9ee7-cdae-504e-ac0c-793e35116944))
(text "04  数字麦克风" (at 152.4 129.54 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 01130d4c-3017-59ea-8b5b-437ea411abff))
(text "05  增益跳线" (at 251.46 129.54 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 942ba33d-30ea-5dbf-bb3b-5d20d9e2d617))
(text "06  摇杆预留" (at 340.36 109.22 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid 0d194a0c-7cbe-5a8f-aa4f-da333152d036))
(text "L/R 接地，使用左声道；供电 3V3。" (at 152.4 187.96 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 4fe68aa5-2504-5394-a863-df1b7f267d5a))
(text "只装一个跳线帽，断电切换。" (at 251.46 172.72 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 9e0c95bc-2301-58ce-bbd8-79b7aef8fdbf))
(text "1-2 = 6dB / OPEN = 9dB / 2-3 = 12dB" (at 251.46 178.435 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 7ddbd3f8-b48b-5103-9f2f-63b6daf92b4b))
(text "GPIO1 / GPIO2 / GPIO8：当前固件尚未启用。" (at 322.58 195.58 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 815a22ac-715e-5c33-bf8d-d4a88ee0e7f2))
(text "07  三个按键：按下接地，使用芯片内部上拉" (at 152.4 205.74 0) (effects (font (face "Noto Sans CJK SC") (size 1.52 1.52)) (justify left top)) (uuid f3e4ba6c-454e-5500-95c1-7f19efaf6db1))
(text "供电由开发板板载 USB / 稳压电路提供；没有电池或充电电路。" (at 20.32 190.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid da4a6fae-8b49-5f76-8c63-43941bcb25e9))
(text "原生 USB GPIO19/20 不接底板外设；叉号表示本底板不使用该引脚。" (at 20.32 197.485 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 516871ca-3160-5e2e-8821-94e1d74e6e7e))
(text "摇杆金属外壳 4 个固定焊脚均为 JS1.0，接 GND。" (at 20.32 204.47 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 409ecbed-6e46-5287-aa14-f51ef593fc06))
(text "GPIO0 上电 / 复位时松开；LCD BLK 直接连接 GPIO42。" (at 20.32 211.455 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid e4a11c52-c169-5fb8-aa46-b6c5a8b06e43))
(text "工程样板：供电余量、背光电流、声学效果与整机装配尚未完成实物验证。" (at 20.32 248.92 0) (effects (font (face "Noto Sans CJK SC") (size 1.27 1.27)) (justify left top)) (uuid d6baaa14-8c00-526e-94e4-f8fc7a7720ac))
(text "此图按已审核 A4 PCB 反向整理；未修改 PCB / Gerber，未重建自动更新 PCB 的 UUID 链接。" (at 20.32 256.54 0) (effects (font (face "Noto Sans CJK SC") (size 1.016 1.016)) (justify left top)) (uuid 2e43e206-14d7-5eda-a883-78b7bda12f71))
