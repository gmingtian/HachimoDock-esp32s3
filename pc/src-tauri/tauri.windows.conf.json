{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": {
      "generated-runtime/node.exe": "bridge/runtime/node.exe",
      "generated-runtime/ffmpeg.exe": "tools/ffmpeg.exe",
      "generated-runtime/ffmpeg.LICENSE": "tools/ffmpeg.LICENSE",
      "generated-runtime/ffmpeg.README": "tools/ffmpeg.README",
      "generated-runtime/ffmpeg.SOURCE.txt": "tools/ffmpeg.SOURCE.txt",
      "generated-runtime/ffmpeg-8.1.2.tar.xz": "tools/source/ffmpeg-8.1.2.tar.xz",
      "generated-runtime/zlib.LICENSE": "tools/zlib.LICENSE",
      "firmware/esp32-s3/firmware.bin": "firmware/esp32-s3/firmware.bin",
      "generated-runtime/s3": "tools/s3-runtime",
      "../../LICENSE": "LICENSE",
      "generated-runtime/node.LICENSE": "licenses/Node-LICENSE.txt"
    }
  }
}
