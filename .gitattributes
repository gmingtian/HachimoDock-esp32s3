* text=auto eol=lf
# Public release resources are kept in ordinary Git so a fresh checkout does
# not depend on the repository owner's separate LFS bandwidth/storage budget.
*.h264 binary
*.mjpg binary
*.wav binary
*.bin binary
# Engineering checksums cover exact bytes, including CSV line endings.
/hardware/s3-carrier/** -text
/hardware/s3-carrier/output/*.csv whitespace=cr-at-eol
# These SVG previews are generated; review source geometry and rendered PNGs.
/hardware/s3-carrier/output/*.svg -diff
